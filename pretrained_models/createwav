import os
import tempfile
import streamlit as st
import pandas as pd
import torch
import torchaudio
from pathlib import Path
from transformers import WhisperProcessor, WhisperForConditionalGeneration
from st_audiorec import st_audiorec

# ----------------- Git Repo Paths -----------------
GIT_REPO_DIR = os.path.join(os.getcwd(), "voice_dataset")  # your local Git repo
WAV_FOLDER = os.path.join(GIT_REPO_DIR, "wavs")
CSV_FILE = os.path.join(GIT_REPO_DIR, "mn-model.csv")
os.makedirs(WAV_FOLDER, exist_ok=True)

# ----------------- Load ASR Model -----------------
@st.cache_resource
def load_mn_asr():
    model_dir = Path("./pretrained_models/mn-sp-mini")
    processor = WhisperProcessor.from_pretrained(model_dir, sampling_rate=16000)
    model = WhisperForConditionalGeneration.from_pretrained(model_dir)
    model.eval()
    device = "cuda" if torch.cuda.is_available() else "cpu"
    model.to(device)
    return processor, model, device

processor, asr_model, device = load_mn_asr()

# ----------------- Session State -----------------
if "audio_data" not in st.session_state:
    st.session_state.audio_data = None
if "transcription" not in st.session_state:
    st.session_state.transcription = ""

# ----------------- Recorder -----------------
st.title("🎤 Voice-to-Text Dataset Recorder")
st.write("Record your voice and save it to the dataset.")

audio_bytes = st_audiorec()
if audio_bytes is not None and len(audio_bytes) > 0:
    st.session_state.audio_data = audio_bytes
    with tempfile.NamedTemporaryFile(delete=False, suffix=".wav") as tmp:
        tmp.write(audio_bytes)
        tmp_path = tmp.name

    # Load & resample audio
    waveform, sr = torchaudio.load(tmp_path)
    if sr != 16000:
        waveform = torchaudio.transforms.Resample(orig_freq=sr, new_freq=16000)(waveform)

    # ASR transcription
    input_features = processor(waveform.squeeze().numpy(), sampling_rate=16000, return_tensors="pt").input_features
    input_features = input_features.to(device)
    with torch.no_grad():
        predicted_ids = asr_model.generate(input_features)
    transcription = processor.batch_decode(predicted_ids, skip_special_tokens=True)[0]
    st.session_state.transcription = transcription.strip()
    st.success(f"Transcribed Text: {st.session_state.transcription}")

# ----------------- Display transcription -----------------
if st.session_state.transcription:
    st.text_area("Transcription", st.session_state.transcription, height=150)

# ----------------- Save to Git repo -----------------
if st.button("💾 Save to Dataset"):
    if st.session_state.transcription:
        timestamp = pd.Timestamp.now().strftime("%Y%m%d_%H%M%S")
        wav_filename = f"audio_{timestamp}.wav"
        wav_path = os.path.join(WAV_FOLDER, wav_filename)

        # Save WAV
        with open(wav_path, "wb") as f:
            f.write(st.session_state.audio_data)

        # Update CSV
        if os.path.exists(CSV_FILE):
            df = pd.read_csv(CSV_FILE)
        else:
            df = pd.DataFrame(columns=["file_path", "text"])

        df = pd.concat([df, pd.DataFrame([{"file_path": f"wavs/{wav_filename}", "text": st.session_state.transcription}])], ignore_index=True)
        df.to_csv(CSV_FILE, index=False)
        st.success(f"✅ Saved WAV and updated CSV: {wav_filename}")
    else:
        st.error("⚠️ No transcription available. Please record audio first.")
